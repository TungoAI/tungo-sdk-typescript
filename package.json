{
  "name": "@tungoai/sdk",
  "version": "0.3.0",
  "description": "Official TypeScript SDK for the Tungo Platform API",
  "license": "MIT",
  "homepage": "https://github.com/TungoAI/tungo-sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TungoAI/tungo-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/TungoAI/tungo-sdk-typescript/issues"
  },
  "keywords": [
    "tungo",
    "tungo-ai",
    "accounting",
    "kazakhstan",
    "sdk",
    "api"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
